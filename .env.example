# Google Sheet used as the database (the long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=

# Service account credentials. Use EITHER the two lines below...
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ...OR paste the whole downloaded JSON key (raw JSON or base64 of it):
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Password that protects the site (strongly recommended on Vercel).
# Leave empty to disable the login screen.
APP_PASSWORD=

# Timezone used to decide what "today" is (Vercel servers run in UTC).
APP_TIMEZONE=Asia/Kolkata
